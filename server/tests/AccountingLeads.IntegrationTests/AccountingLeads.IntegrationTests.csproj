<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!--
      All tests in this project share one physical LocalDB database
      (AccountingLeadsDb_IntegrationTests, see IntegrationTestWebApplicationFactory). xUnit runs
      different test classes as separate collections in parallel by default, which races
      multiple WebApplicationFactory instances (each its own in-process host) against that one
      shared database's migration/reset lifecycle. Disable parallelization so integration tests
      run sequentially against it instead.
    -->
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AccountingLeads.Api\AccountingLeads.Api.csproj" />
    <ProjectReference Include="..\..\src\AccountingLeads.Application\AccountingLeads.Application.csproj" />
    <ProjectReference Include="..\..\src\AccountingLeads.Infrastructure\AccountingLeads.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\AccountingLeads.Domain\AccountingLeads.Domain.csproj" />
  </ItemGroup>

</Project>